## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Logs
*.log


# Temporarios
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~
~$*

# Arquivos de lock temporarios
*.lock
*.pid

# Saidas e artefatos gerados
out/
output/
build/
dist/
tmp/
temp/
.cache/
cache/

# Credenciais e configuracoes locais
.env
.env.*
!.env.example
*.secret
*.secrets
secrets/
credentials/
credentials.json

# Chaves e certificados
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer

# PowerShell
*.clixml
*.ps1xml.tmp

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.fuse_hidden*
.nfs*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editores / IDEs
.vscode/
.idea/
*.code-workspace

# Visual Studio
.vs/
bin/
obj/

# JetBrains
*.iml

# Node, caso alguma automacao use JavaScript/TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python, caso alguma automacao use Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Dumps
*.dmp
*.dump
*.core

# Arquivos de diagnostico
*.trace
*.etl

# Arquivos locais de configuracao
*.local
*.user

# Arquivos gerados por testes
coverage/
test-results/
